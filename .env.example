# ==============================================================
# CPPEM Carreiras — Variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com seus dados
# ==============================================================

# URL do seu projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave pública (anon) do Supabase — segura para uso no client
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave service_role do Supabase (Project Settings > API > service_role).
# Necessária para o formulário de candidatura e o link de agendamento de
# entrevistas (o visitante grava pelo servidor). Fica SÓ no servidor: nunca
# coloque NEXT_PUBLIC_ na frente e nunca use no navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# (Opcional) Chave da API da DeepSeek (platform.deepseek.com > API keys),
# usada no scorecard de IA das candidaturas. Sem ela, as candidaturas chegam
# normalmente e ficam aguardando avaliação.
# DEEPSEEK_API_KEY=sk-...
# (Opcional) Modelo da DeepSeek. Padrão: deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# (Opcional) Endereço público do site, usado em sitemap, imagens de
# compartilhamento e dados estruturados de vaga. Se você ligar um domínio
# próprio (ex.: https://vagas.cppem.com.br), coloque aqui. Sem isto, o site
# usa o domínio de produção que a Vercel informa sozinha.
# NEXT_PUBLIC_SITE_URL=https://vagas.cppem.com.br
